@model TaskEFC.Models.Order

<dl class="row">
    <dt class="col-sm-2">OrderDate</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.OrderDate)</dd>
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.Customer?.FullName</dd>
    <dt class="col-sm-2">SuperMarket</dt>
    <dd class="col-sm-10">@Model.Supermarket?.Name, @Model.Supermarket?.Address</dd>
</dl>

<partial name="_OrderLines" model="Model" />
