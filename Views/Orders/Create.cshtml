@model TaskEFC.ViewModels.OrderCreateViewModel

@{
    ViewData["Title"] = "Create Order";
}

<h1>Create</h1>

<h4>Order</h4>
<hr />
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="CustomerId" class="control-label"></label>
            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                <option value="">-- select a customer --</option>
            </select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="SupermarketId" class="control-label"></label>
            <select asp-for="SupermarketId" asp-items="ViewBag.Supermarkets" class="form-select">
                <option value="">-- select a supermarket --</option>
            </select>
            <span asp-validation-for="SupermarketId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="OrderDate" class="control-label"></label>
            <input asp-for="OrderDate" class="form-control" />
            <span asp-validation-for="OrderDate" class="text-danger"></span>
        </div>
    </div>

    <h5>Products</h5>
    <p class="text-muted">Enter a quantity for every product you want to order.</p>
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Cost</th>
            </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            <tr data-price="@Model.Lines[i].Price">
                <td>
                    <input type="hidden" asp-for="Lines[i].ProductId" />
                    <label asp-for="Lines[i].Quantity">@Model.Lines[i].ProductName</label>
                </td>
                <td>@Model.Lines[i].Price.ToString("F2")</td>
                <td>
                    <input asp-for="Lines[i].Quantity" type="number" min="0" step="any" class="form-control quantity" />
                    <span asp-validation-for="Lines[i].Quantity" class="text-danger"></span>
                </td>
                <td class="line-cost">0.00</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total cost</th>
                <th id="total-cost">0.00</th>
            </tr>
        </tfoot>
    </table>

    <input type="submit" value="Create" class="btn btn-primary" />
</form>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/order-total.js" asp-append-version="true"></script>
}
